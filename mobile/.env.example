# Public runtime configuration (NOT secrets).
# Copy to .env and adjust. Only EXPO_PUBLIC_* variables are inlined into the JS bundle.

# Which environment the app runs against: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# API base URL. For the backend default (/api/v1 is appended automatically).
# Android emulators: use http://10.0.2.2:8000 to reach the host machine.
# Physical devices: use your computer's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
