# ---- Core ----
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Matchmaking API
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://matchmake:matchmake@localhost:5432/matchmaking
# Test database (SQLite by default so tests run without Postgres)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_matchmaking.db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Object storage (S3-compatible) ----
STORAGE_BACKEND=local            # local | s3
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=matchmaking-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_UPLOAD_URL_EXPIRES=3600
S3_DOWNLOAD_URL_EXPIRES=3600
LOCAL_STORAGE_PATH=./storage

# ---- Payments ----
PAYMENT_PROVIDER=mock            # mock | stripe | razorpay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ---- Email / SMS ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@matchmaking.local
SMS_PROVIDER=mock
SMS_API_KEY=

# ---- Security / limits ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/15m         # attempts / window
OTP_RATE_LIMIT=5/15m
MAX_PHOTO_SIZE_MB=10
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_PROXY_COUNT=0

# ---- Workers ----
CELERY_OR_ARQ_REDIS=redis://localhost:6379/1

# ---- Remote app configuration cache ----
APP_CONFIG_CACHE_TTL=900
APP_CONFIG_CACHE_KEY=app_config:public

# ---- Seed ----
SEED_LANGUAGES="en,hi,ta,te,kn,ml,pa,bn,gu,or,ma"

# ---- Development admin (optional, only created when both are set) ----
# The dev admin is created by `python -m app.seed` as SUPER_ADMIN.
# Never set these in production. The password is never logged or committed.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=ChangeMe123!

# ---- Admin dashboard CORS ----
# Origins allowed to call the API from the browser (admin + mobile).
# Never use ["*"] in production.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
