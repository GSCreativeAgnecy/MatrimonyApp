# Browser-visible API origin. Baked into the client bundle at build time
# (docker-compose build arg: PUBLIC_API_BASE_URL).
NEXT_PUBLIC_API_BASE_URL=https://api.ardhangmatrimony.com

# Server-side API origin used by the BFF auth routes (app/api/auth/*).
# In docker-compose this is set to http://api:8000; for local dev the fallback
# is NEXT_PUBLIC_API_BASE_URL or http://localhost:8000.
WEB_API_URL=http://localhost:8000
